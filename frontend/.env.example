# URL de l'API backend (optionnel, defaut: http://localhost:5000/api)
VITE_API_URL=http://localhost:5000/api

# Cles PUBLIQUES (safe cote client) - passerelles de paiement
# Stripe : cle publiable (commence par pk_), depuis le dashboard Stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# FedaPay : cle publique, depuis le dashboard FedaPay
# Le domaine du site doit etre autorise dans FedaPay > Applications
VITE_FEDAPAY_PUBLIC_KEY=pk_sandbox_xxx
