# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/zoba

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Admin credentials (for initial setup - no default admin is created if unset)
ADMIN_EMAIL=admin@zoba-cbt.org
ADMIN_PASSWORD=change-me-now

# Stripe (optional - card payments: donations redirect to Stripe Checkout; activity
# registrations use embedded Stripe Elements)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# FedaPay (optional - Mobile Money / cartes pour l'Afrique de l'Ouest ; les dons redirigent
# vers la page de paiement hebergee FedaPay, les inscriptions aux activites utilisent le
# widget Checkout.js embarque)
FEDAPAY_SECRET_KEY=sk_sandbox_xxx
FEDAPAY_WEBHOOK_SECRET=whsec_xxx
FEDAPAY_ENV=sandbox
# Optionnel : URL de rappel par defaut. Les dons utilisent leur propre page de retour
# (FRONTEND_URL/dons/retour/<id>) et les billets le widget embarque : laisser vide en general.
FEDAPAY_CALLBACK_URL=

# Cloudinary (optionnel - upload d'images depuis l'admin : membres, activites, actualites, galerie ;
# videos de la galerie televersees directement du navigateur vers Cloudinary, 100 Mo max)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Resend (optionnel - envoi des billets d'inscription (QR code) et des recus de don par email)
RESEND_API_KEY=re_xxx
# Adresse d'expedition : doit provenir d'un domaine verifie dans Resend
# (ou onboarding@resend.dev en mode test, limite a votre propre adresse)
EMAIL_FROM=billets@zoba-cbt.org

# Mesure d'audience maison (optionnel) : secret servant a hacher l'IP des visiteurs avec un sel
# quotidien. A defaut, JWT_SECRET est utilise. L'IP elle-meme n'est jamais stockee.
ANALYTICS_SALT=

# Duree de session admin en heures (optionnel, defaut 12, max 168)
ADMIN_SESSION_HOURS=12
