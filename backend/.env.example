# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/zoba

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Admin credentials (for initial setup - no default admin is created if unset)
ADMIN_EMAIL=admin@zoba-cbt.org
ADMIN_PASSWORD=change-me-now

# Stripe (optional - card payments via Stripe Elements, embedded on the donations page)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# FedaPay (optional - Mobile Money / cartes pour l'Afrique de l'Ouest, via le widget Checkout.js)
FEDAPAY_SECRET_KEY=sk_sandbox_xxx
FEDAPAY_WEBHOOK_SECRET=whsec_xxx
FEDAPAY_ENV=sandbox
# Optionnel : URL de rappel pour les modes de paiement FedaPay qui redirigent
FEDAPAY_CALLBACK_URL=http://localhost:5173/dons?payment=success

# Cloudinary (optionnel - upload d'images depuis l'admin : membres, activites, actualites, galerie)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Resend (optionnel - envoi des billets d'inscription par email avec QR code)
RESEND_API_KEY=re_xxx
# Adresse d'expedition : doit provenir d'un domaine verifie dans Resend
# (ou onboarding@resend.dev en mode test, limite a votre propre adresse)
EMAIL_FROM=billets@zoba-cbt.org
